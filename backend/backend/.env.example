# --- required ---
FIREBASE_RTDB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
FIREBASE_DB_SECRET=
ADMIN_USERNAME=admin
# Use ONE of these (hash preferred):  python scripts/hash_password.py 'password'
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
# 32+ random chars. Seeds the key used to encrypt API responses (must be identical on every worker/instance).
APP_SECRET=

# --- optional ---
ALLOWED_ORIGINS=*
UPSTREAM_BASE=https://img.elochkaigolochla.com/api/v1/catalog
UPSTREAM_FALLBACK=https://mapi.elochkaigolochla.com/api/v1/catalog
ENCRYPT_API=1
ADMIN_SESSION_HOURS=12
STATS_UTC_OFFSET_MIN=330
EXTRA_AD_HOSTS=
